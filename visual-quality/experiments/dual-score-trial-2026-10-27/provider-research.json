    "gemini_model": "https://openrouter.ai/google/gemini-3.8-flash",
    "catalog": "https://openrouter.ai/api/v1/models",
    "gemini_endpoints": "https://openrouter.ai/api/v1/models/google/gemini-3.8-flash-20260902/endpoints",
    "luna_endpoints": "https://openrouter.ai/api/v1/models/openai/gpt-6-luna-20260922/endpoints"
  },
  "findings": [
    {
      "claim": "Both exact requested model IDs are present, accept image input, support response_format and structured_outputs, and expose the requested reasoning efforts.",
      "sources": [
        "catalog",
        "gemini_endpoints",
        "luna_endpoints"
      ]
    },
    {
      "claim": "Use response_format.type=json_schema with json_schema.strict=true; require all output keys and additionalProperties=false. Provider enforcement differs and compliance still needs independent validation.",
      "sources": [
        "structured_outputs"
      ]
    },
    {
      "claim": "Use provider.require_parameters=true so incompatible endpoints fail routing instead of silently dropping requested parameters. Endpoint support, not model aggregation alone, controls eligibility.",
      "sources": [
        "structured_outputs",
        "provider_routing"
      ]
    },
    {
      "claim": "GPT-6 Luna does not list temperature in any endpoint supported_parameters. Omit it. Google AI Studio lists temperature, but Google Vertex endpoints do not; setting temperature=0 with require_parameters=true restricts eligible Gemini routes.",
      "sources": [
        "gemini_endpoints",
        "luna_endpoints"
      ]
    },
    {
      "claim": "Use reasoning.effort=medium for Gemini and high for Luna. Gemini supports high/medium/low and mandatory reasoning; Luna supports max/xhigh/high/medium/low/none.",
      "sources": [
        "catalog",
        "reasoning"
      ]
    },
    {
      "claim": "max_tokens generally covers both reasoning and visible output; exhausting it during reasoning can return finish_reason=length with empty content while charging tokens. reasoning.exclude=true hides reasoning text without disabling reasoning or avoiding its charge.",
      "sources": [
        "reasoning"
      ]
    },
    {
      "claim": "usage is included automatically; usage.cost is the account charge. Retrieve GET /api/v1/generation?id=gen-... with bearer auth to audit total_cost, model, provider_name, native token counts, and finish reason.",
      "sources": [
        "usage",
        "generation"
      ]
    },
    {
      "claim": "Endpoint prices vary by service tier and region. The standard Google AI Studio endpoint is $0.75 input/$3.75 output per million tokens; standard OpenAI is $0.10 input/$0.50 output per million. Larger-context Luna pricing overrides apply at 272000 prompt tokens.",
      "sources": [
        "gemini_endpoints",
        "luna_endpoints"
      ]
    }
  ],
  "implementation_suggestions_not_provider_guarantees": {
    "pin_routes": {
      "google/gemini-3.8-flash": {
        "only": [
          "google-ai-studio"
        ],
        "allow_fallbacks": false,
        "require_parameters": true
      },
      "openai/gpt-6-luna": {
        "only": [
          "openai"
        ],
        "allow_fallbacks": false,
        "require_parameters": true
      }
    },
    "max_tokens": 16384,
    "notes": [
      "16384 is a suggested trial cap, not a guaranteed sufficient reasoning budget; probe before freezing the image run and count truncations as failures.",
      "Do not enable response-healing: measure original provider output conformance.",
      "Keep exact fixed-decimal score strings in the schema enum and independently validate raw responses.",
      "A provider match verifies eligible parameter support but does not cryptographically prove the upstream reasoning effort. Preserve exact request and provider metadata."
    ]
  },
