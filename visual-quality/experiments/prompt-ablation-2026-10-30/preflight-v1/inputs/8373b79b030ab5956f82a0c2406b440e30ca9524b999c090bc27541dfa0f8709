"""Prompt-only ablations of the unchanged, strictly validated joint score wire format."""

import hashlib
import importlib.util
import json
from pathlib import Path

BASE_PATH = Path(__file__).resolve().parent.parent / "dual-score-trial-2026-10-27/wire.py"
_spec = importlib.util.spec_from_file_location("frozen_dual_score_wire", BASE_PATH)
_base = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_base)

TASKS = _base.TASKS
SCORES = _base.SCORES
LIMITATIONS = _base.LIMITATIONS
ADAPTER_VERSION = _base.ADAPTER_VERSION
parse_joint = _base.parse_joint
ARM_IDS = ("baseline", "A", "B", "C", "D", "combined")


def load_arms(path: Path) -> list[dict]:
    arms = json.loads(path.read_text())["arms"]
    if len(arms) != 6 or {arm["id"] for arm in arms} != set(ARM_IDS):
        raise ValueError("Exactly baseline, A, B, C, D, combined arms are required")
    by_id = {arm["id"]: arm for arm in arms}
    if by_id["baseline"]["addendum"] != "":
        raise ValueError("Baseline must have no additions")
    for arm in arms:
        if not isinstance(arm["addendum"], str) or "OUTPUT CONTRACT" in arm["addendum"]:
            raise ValueError("Addendum must be text without an output contract override")
        if arm["id"] != "baseline" and not arm["addendum"].strip():
            raise ValueError("Every treatment needs an addendum")
    return [by_id[name] for name in ARM_IDS]


def prompt_bundle(directory: Path, arm: dict) -> dict:
    result = _base.prompt_bundle(directory)
    if arm["id"] == "baseline":
        if arm["addendum"]:
            raise ValueError("Baseline must remain byte-identical")
        return result
    if arm["id"] not in ARM_IDS or not arm["addendum"].strip():
        raise ValueError("Invalid treatment arm")
    if result["user"].count("OUTPUT CONTRACT") != 1:
        raise ValueError("Output contract insertion marker changed")
    result["user"] = result["user"].replace(
        "OUTPUT CONTRACT", "SCORING CLARIFICATION\n\n" + arm["addendum"].strip() + "\n\nOUTPUT CONTRACT"
    )
    result["version"] = "visual-rating-v1-ablation-" + arm["id"]
    result.pop("sha256")
    result["sha256"] = hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest()
    return result
