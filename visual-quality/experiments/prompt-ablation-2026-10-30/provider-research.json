  "findings": [
    {
      "claim": "All three exact OpenRouter model IDs exist, accept image input, list the requested effort, and have pinned endpoints that advertise both response_format and structured_outputs.",
      "sources": [
        "catalog",
        "haiku_endpoints",
        "gemini_endpoints",
        "luna_endpoints"
      ]
    },
    {
      "claim": "Use response_format.type=json_schema with json_schema.strict=true, required properties, and additionalProperties=false. Endpoint support and strict enforcement differ; independent parsing and conformance probes remain necessary.",
      "sources": [
        "structured_outputs"
      ]
    },
    {
      "claim": "Require parameters and disable fallback when pinning providers; catalogue support alone does not validate an actual inference response.",
      "sources": [
        "provider_routing",
        "structured_outputs"
      ]
    },
    {
      "claim": "Haiku low effort maps to native adaptive thinking with output_config.effort=low. A fixed thinking-token budget is not used or forwarded.",
      "sources": [
        "claude_55_migration"
      ]
    },
    {
      "claim": "Haiku and Luna should omit temperature because the selected endpoints do not advertise it. Gemini Google AI Studio continues to advertise temperature.",
      "sources": [
        "haiku_endpoints",
        "luna_endpoints",
        "gemini_endpoints",
        "claude_55_migration"
      ]
    },
    {
      "claim": "The selected standard Anthropic Haiku endpoint costs $0.10 input/$0.50 output per million tokens, with catalog override at min_prompt_tokens=100000 of $0.50/$2.50. Conservative whole-context reserves must cover the override.",
      "sources": [
        "haiku_endpoints"
      ]
    },
    {
      "claim": "The existing Gemini ceiling $0.825/$4.125 per million exceeds its selected endpoint listed $0.75/$3.75 rate. Existing Luna ceilings $0.20/$0.75 cover its selected endpoint long-context override at 272000 prompt tokens.",
      "sources": [
        "gemini_endpoints",
        "luna_endpoints"
      ]
    }
